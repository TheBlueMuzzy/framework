{
  "id": "hello",
  "version": 1,
  "watchdogMs": 1200000,
  "steps": [
    {
      "id": "name",
      "kind": "talk",
      "needs": [],
      "tools": ["AskUserQuestion", "ToolSearch"],
      "craft": "craft/name.md",
      "done": { "type": "result-has", "key": "name" }
    },
    {
      "id": "approve",
      "kind": "gate",
      "needs": ["name"],
      "question": "Plan card: a hello page for \"{name}\". Approve it?",
      "options": ["Approve", "Change the name"],
      "backTo": "name"
    },
    {
      "id": "plan",
      "kind": "script",
      "needs": ["approve"],
      "run": ["node", "{plugin}/scripts/write-plan.mjs", "{project}", "{name}"],
      "writes": ["plan.json"],
      "done": { "type": "file-json-has", "path": "plan.json", "key": "name" }
    },
    {
      "id": "hello",
      "kind": "flow",
      "needs": ["plan"],
      "workflow": "bmuz-proof:hello-flow",
      "args": { "name": "{name}", "out": "hello.html" },
      "agentTools": ["Write", "Read"],
      "writes": ["hello.html"],
      "craft": "craft/hello.md",
      "done": { "type": "file-contains", "path": "hello.html", "text": "{name}" }
    },
    {
      "id": "review",
      "kind": "talk",
      "needs": ["hello"],
      "tools": ["Read", "Glob", "Grep"],
      "craft": "craft/review.md",
      "done": { "type": "result-has", "key": "verdict" }
    }
  ]
}
