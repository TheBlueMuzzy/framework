{
  "name": "turn-based-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The framework's turn-based starter: tic-tac-toe with every framework module installed and wired. A new game copies it; the framework's checks play it on every module change.",
  "scripts": {
    "dev": "vite --port 6173",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "check:fast": "node scripts/check-all.mjs fast",
    "check:full": "node scripts/check-all.mjs full",
    "check:framework": "node src/devkit/check-framework.mjs",
    "audio:check": "node src/audio/audio-check.mjs"
  },
  "dependencies": {
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "playwright-core": "^1.63.0",
    "source-map": "^0.8.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "wrangler": "^4.151.2"
  }
}
